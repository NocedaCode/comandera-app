<file path="app/cocina/page.jsx">
'use client'

import { useState, useEffect } from 'react'
import { supabase } from '@/lib/supabase'

export default function CocinaPage() {
  const [pedidos, setPedidos] = useState([])

  useEffect(() => {
    // 1. Declaramos la función DENTRO del useEffect
    const cargarPedidos = async () => {
      const { data, error } = await supabase
        .from('pedidos')
        .select('*')
        .neq('estado', 'entregado')
        .neq('estado', 'archivado')
        .order('created_at', { ascending: true })

      if (!error && data) {
        setPedidos(data)
      }
    }

    // Carga inicial
    cargarPedidos()

    // Suscripción Realtime
    const canal = supabase
      .channel('cocina-realtime')
      .on(
        'postgres_changes',
        { event: '*', schema: 'public', table: 'pedidos' },
        () => {
          cargarPedidos()
        }
      )
      .subscribe()

    return () => {
      if (canal) {
        supabase.removeChannel(canal)
      }
    }
  }, []) // Ahora el array de dependencias vacío es 100% válido y sin advertencias

  const cambiarEstado = async (id, nuevoEstado) => {
    // Al actualizar el registro, el evento postgres_changes de Realtime
    // se dispara automáticamente y recarga las comandas.
    const { error } = await supabase
      .from('pedidos')
      .update({ estado: nuevoEstado })
      .eq('id', id)

    if (error) {
      alert('Error al actualizar la comanda: ' + error.message)
    }
  }

  return (
    <div className="page-container-wide">
      <header className="mb-8 text-center border-b border-neutral-800 pb-6">
        <h1 className="header-title">Comandera de Cocina</h1>
        <p className="header-subtitle">Gestión en Tiempo Real</p>
      </header>

      <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
        {pedidos.map((pedido) => (
          <div key={pedido.id} className="card-panel flex flex-col justify-between">
            <div>
              <div className="flex justify-between items-center mb-4 pb-3 border-b border-neutral-800">
                <span className="text-xl font-bold text-amber-300">{pedido.mesa}</span>
                <span className="px-3 py-1 text-[10px] font-black uppercase rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/30">
                  {pedido.tipo_servicio}
                </span>
              </div>

              <div className="space-y-3">
                {pedido.items?.map((item, idx) => (
                  <div key={idx} className="text-xs">
                    <span className="text-amber-400 font-black mr-2">{item.cantidad}x</span>
                    <span className="text-zinc-200">{item.nombre}</span>
                    {item.notas && <p className="text-[11px] text-amber-300/80 italic mt-1">Nota: {item.notas}</p>}
                  </div>
                ))}
              </div>
            </div>

            <div className="mt-6 pt-3 border-t border-neutral-800">
              {pedido.estado === 'pendiente' ? (
                <button onClick={() => cambiarEstado(pedido.id, 'listo')} className="btn-whatsapp py-3.5 text-xs">
                  MARCAR LISTO
                </button>
              ) : (
                <button onClick={() => cambiarEstado(pedido.id, 'entregado')} className="btn-secundario py-3.5 text-xs">
                  ENTREGAR Y ARCHIVAR
                </button>
              )}
            </div>
          </div>
        ))}
      </div>

      {pedidos.length === 0 && (
        <div className="text-center py-20 text-neutral-500 text-xs font-black tracking-widest uppercase">
          NO HAY COMANDAS PENDIENTES
        </div>
      )}
    </div>
  )
}
</file>

<file path="app/resumen/page.jsx">
'use client'

import { useState, useEffect } from 'react'
import { supabase } from '@/lib/supabase'

export default function ResumenPage() {
  const [totalVentas, setTotalVentas] = useState(0)
  const [totalPedidos, setTotalPedidos] = useState(0)
  const [cargando, setCargando] = useState(true)

  // Función principal para obtener totales
  const obtenerTotales = async () => {
    setCargando(true)
    const hoy = new Date()
    hoy.setHours(0, 0, 0, 0)

    const { data, error } = await supabase
      .from('pedidos')
      .select('total')
      .gte('created_at', hoy.toISOString())
      .neq('estado', 'archivado')

    if (!error && data) {
      setTotalPedidos(data.length)
      const suma = data.reduce((acc, p) => acc + (Number(p.total) || 0), 0)
      setTotalVentas(suma)
    } else if (error) {
      console.error("Error al consultar pedidos:", error.message)
    }

    setCargando(false)
  }

  // Carga inicial al montar la página
  useEffect(() => {
    let cancelado = false

    const cargarDatosIniciales = async () => {
      const hoy = new Date()
      hoy.setHours(0, 0, 0, 0)

      const { data, error } = await supabase
        .from('pedidos')
        .select('total')
        .gte('created_at', hoy.toISOString())
        .neq('estado', 'archivado')

      if (!cancelado) {
        if (!error && data) {
          setTotalPedidos(data.length)
          const suma = data.reduce((acc, p) => acc + (Number(p.total) || 0), 0)
          setTotalVentas(suma)
        }
        setCargando(false)
      }
    }

    cargarDatosIniciales()

    return () => {
      cancelado = true
    }
  }, [])

  // Cierre de jornada
  const cerrarJornadaYEnviarWhatsApp = async () => {
    if (totalPedidos === 0 && totalVentas === 0) {
      alert("No hay comandas activas registradas para cerrar.")
      return
    }

    const confirmar = confirm(
      `CONFIRMACIÓN DE CIERRE DE JORNADA\n\nComandas procesadas: ${totalPedidos}\nTotal ganado hoy: $${totalVentas.toFixed(2)}\n\n¿Deseas cerrar la jornada, limpiar las comandas del día y abrir WhatsApp?`
    )
    if (!confirmar) return

    const hoyStr = new Date().toLocaleDateString('es-VE', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric'
    })

    const mensaje = `REPORTE DE CIERRE DE CAJA\nFecha: ${hoyStr}\n-----------------------------------\nComandas Atendidas: ${totalPedidos}\nTotal Ganado del Día: $${totalVentas.toFixed(2)}\n-----------------------------------\nJornada Finalizada Exitosamente.`

    const urlWhatsApp = `https://wa.me/584246172567?text=${encodeURIComponent(mensaje)}`

    const { error } = await supabase
      .from('pedidos')
      .update({ estado: 'archivado' })
      .neq('estado', 'archivado')

    if (error) {
      alert("Error al archivar las comandas: " + error.message)
    } else {
      window.open(urlWhatsApp, '_blank')
      await obtenerTotales()
      alert("Jornada cerrada con éxito.")
    }
  }

  return (
    <div className="page-container flex flex-col justify-center min-h-screen">
      <h1 className="header-title">Cierre de Caja</h1>
      <p className="header-subtitle mb-8">Resumen Diario de Ventas</p>

      <div className="card-panel mb-8 text-center space-y-6">
        <div>
          <p className="input-label">Comandas Atendidas Hoy</p>
          <p className="text-5xl font-black text-white">
            {cargando ? "..." : totalPedidos}
          </p>
        </div>
        
        <div className="border-t border-neutral-800 pt-6">
          <p className="input-label">Total Ganado Hoy</p>
          <p className="text-5xl font-black text-amber-400">
            ${cargando ? "..." : totalVentas.toFixed(2)}
          </p>
        </div>
      </div>

      <div className="space-y-4">
        <button 
          onClick={obtenerTotales} 
          disabled={cargando}
          className="btn-secundario py-4 text-xs disabled:opacity-50"
        >
          {cargando ? "Cargando..." : "Actualizar Datos"}
        </button>

        <button 
          onClick={cerrarJornadaYEnviarWhatsApp} 
          disabled={cargando}
          className="btn-whatsapp py-5 text-xs sm:text-sm disabled:opacity-50"
        >
          Cerrar Jornada y Enviar a WhatsApp
        </button>
      </div>
    </div>
  )
}
</file>

