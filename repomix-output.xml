@import "tailwindcss";

@layer utilities {
  .font-display {
    font-family: 'Playfair Display', Georgia, Cambria, "Times New Roman", Times, serif;
  }
}

:root {
  --background: #09090b;
  --foreground: #f4f4f5;
}

body {
  background-color: var(--background);
  color: var(--foreground);
  font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  overflow-x: hidden;
  background-image: 
    radial-gradient(at 0% 0%, rgba(212, 175, 55, 0.08) 0px, transparent 50%),
    radial-gradient(at 100% 100%, rgba(212, 175, 55, 0.05) 0px, transparent 50%);
}

/* =========================================================
   1. ESTRUCTURA GLOBAL Y PANTALLAS
   ========================================================= */
.page-container {
  min-height: 100vh;
  padding: 1rem;
  max-width: 32rem; /* Por defecto estilo móvil */
  margin-left: auto;
  margin-right: auto;
  animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

.page-container-wide {
  min-height: 100vh;
  padding: 1rem;
  max-width: 80rem; /* Ancho completo para cocina */
  margin-left: auto;
  margin-right: auto;
  animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(16px) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

/* =========================================================
   2. ENCABEZADOS Y TEXTOS
   ========================================================= */
.header-title {
  font-family: 'Playfair Display', Georgia, Cambria, serif;
  font-size: 2.25rem;
  font-weight: 900;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: -0.025em;
  background: linear-gradient(135deg, #fef08a 0%, #eab308 50%, #ca8a04 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  margin-bottom: 0.5rem;
}

.header-subtitle {
  font-size: 0.65rem;
  font-weight: 900;
  color: #a1a1aa;
  text-transform: uppercase;
  letter-spacing: 0.25em;
  text-align: center;
}

/* =========================================================
   3. TARJETAS Y CONTENEDORES (GLASSMORPHISM)
   ========================================================= */
.card-panel {
  background: rgba(24, 24, 27, 0.9);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(234, 179, 8, 0.35);
  box-shadow: 0 10px 30px -10px rgba(234, 179, 8, 0.15);
  border-radius: 1.5rem;
  padding: 1.5rem;
}

/* =========================================================
   4. FORMULARIOS E INPUTS
   ========================================================= */
.input-field {
  width: 100%;
  padding: 1rem;
  background-color: #18181b;
  border: 1px solid #27272a;
  border-radius: 1rem;
  color: #f4f4f5;
  font-size: 0.875rem;
  outline: none;
  transition: all 0.2s;
}

.input-field:focus {
  border-color: #eab308;
}

.input-label {
  display: block;
  font-size: 0.625rem;
  font-weight: 900;
  color: #facc15;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin-bottom: 0.5rem;
}

/* =========================================================
   5. BOTONES GLOBALES
   ========================================================= */
/* Botón Dorado (Acciones Principales) */
.btn-primario {
  width: 100%;
  background: linear-gradient(135deg, #fef08a 0%, #eab308 50%, #ca8a04 100%);
  color: #09090b;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  border: 1px solid #fef08a;
  box-shadow: 0 0 20px rgba(234, 179, 8, 0.3);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  border-radius: 1rem;
}

.btn-primario:hover {
  transform: translateY(-2px) scale(1.01);
  box-shadow: 0 0 30px rgba(234, 179, 8, 0.6);
}

.btn-primario:active {
  transform: translateY(1px) scale(0.98);
}

/* Botón Secundario (Oscuro) */
.btn-secundario {
  width: 100%;
  background-color: #171717;
  color: #fef08a;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  border: 2px solid rgba(234, 179, 8, 0.5);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  border-radius: 1rem;
}

.btn-secundario:hover {
  background-color: #262626;
  border-color: #eab308;
  transform: translateY(-1px);
}

.btn-secundario:active {
  transform: translateY(1px) scale(0.98);
}

/* Botón Verde (WhatsApp y Listo) */
